local function GetGuards()
    local GuardList = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team then
            local TeamName = player.Team.Name
            if TeamName == "MTF" or TeamName == "Guard" then
                table.insert(GuardList, player)
            end
        end
    end
    return GuardList
end

local function UpdateGuardBring(targetPosition)
    local guards = GetGuards()
    local guardCount = #guards
    if guardCount == 0 then return end
    local angleStep = 2 * math.pi / guardCount
    for i, player in ipairs(guards) do
        local Character = player.Character
        if Character then Character = Character:FindFirstChild("HumanoidRootPart") end
        if Character then
            local angle = (i - 1) * angleStep
            local offsetX = math.cos(angle) * GuardRadius
            local offsetZ = math.sin(angle) * GuardRadius
            local targetVector = Vector3.new(targetPosition.X + offsetX, targetPosition.Y, targetPosition.Z + offsetZ)
            Character.CFrame = CFrame.new(targetVector, targetPosition)
        end
    end
end

local function StartGuardBring()
    if GuardConnection then GuardConnection:Disconnect() end
    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local HumanoidRootPart = Character:WaitForChild("HumanoidRootPart", 5)
    if not HumanoidRootPart then return end
    local lastPos = HumanoidRootPart.Position
    UpdateGuardBring(lastPos)
    GuardConnection = RunService.RenderStepped:Connect(function()
        local CurrentChar = LocalPlayer.Character
        if CurrentChar then CurrentChar = CurrentChar:FindFirstChild("HumanoidRootPart") end
        if not CurrentChar or not lastPos then return end
        local currentPos = CurrentChar.Position
        local guards = GetGuards()
        local guardCount = #guards
        if guardCount == 0 then return end
        if (currentPos - lastPos).Magnitude > GuardRadius then
            lastPos = currentPos
            UpdateGuardBring(lastPos)
            return
        end
        local angleStep = 2 * math.pi / guardCount
        for i, player in ipairs(guards) do
            local TargetChar = player.Character
            local RootPart = TargetChar and TargetChar:FindFirstChild("HumanoidRootPart")
            local Humanoid = TargetChar and TargetChar:FindFirstChildOfClass("Humanoid")
            if RootPart and Humanoid and Humanoid.Health > 0 then
                RootPart.Velocity = Vector3.new(0, 0, 0)
                RootPart.RotVelocity = Vector3.new(0, 0, 0)
                local angle = (i - 1) * angleStep
                local offsetX = math.cos(angle) * GuardRadius
                local offsetZ = math.sin(angle) * GuardRadius
                local targetVector = Vector3.new(lastPos.X + offsetX, lastPos.Y, lastPos.Z + offsetZ)
                RootPart.CFrame = CFrame.new(targetVector, lastPos)
            end
        end
    end)
end

