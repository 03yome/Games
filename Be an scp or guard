    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Team then
            local teamName = player.Team.Name
            if espSCP and teamName == "SCP" then
                updateEsp(player, Color3.fromRGB(255, 0, 0))
            elseif espGuard and (teamName == "MTF" or teamName == "Guard") then
