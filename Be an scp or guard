MainTab:CreateToggle({
    Name = "Bring All Guard V2",
    CurrentValue = false,
    Callback = function(Value)
        bringGuardActive = Value
        if Value then
            local char = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local root = char:WaitForChild("HumanoidRootPart", 5)
            if not root then return end
            bringGuardConn = RunService.RenderStepped:Connect(function()
                local guards = getGuards()
                if #guards == 0 then return end
                local angleStep = 2 * math.pi / #guards
                for i, p in ipairs(guards) do
                    local pChar = p.Character
                    local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
                    local pHum = pChar and pChar:FindFirstChildOfClass("Humanoid")
                    if pRoot and pHum and pHum.Health > 0 then
                        pRoot.Velocity = Vector3.zero
                        pRoot.RotVelocity = Vector3.zero
                        local angle = (i - 1) * angleStep
                        local offset = Vector3.new(math.cos(angle) * 12, 0, math.sin(angle) * 12)
                        pRoot.CFrame = CFrame.new(root.Position + offset, root.Position)
                    end
                end
            end)
        else
            if bringGuardConn then bringGuardConn:Disconnect() end
        end
    end,
})

