local function UpdateESP(player, color)
    local Character = player.Character
    if not Character then return end
    local Humanoid = Character:FindFirstChildOfClass("Humanoid")
    local ESP_Solid = Character:FindFirstChild("ESP_Solid")
    if not Humanoid or Humanoid.Health <= 0 then
        if ESP_Solid then ESP_Solid:Destroy() end
        return
    end
    if not ESP_Solid or not ESP_Solid:IsA("Highlight") then
        if ESP_Solid then ESP_Solid:Destroy() end
        ESP_Solid = Instance.new("Highlight")
        ESP_Solid.Name = "ESP_Solid"
        ESP_Solid.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        ESP_Solid.Parent = Character
    end
    ESP_Solid.FillColor = color
    ESP_Solid.FillTransparency = 0.9
    ESP_Solid.OutlineColor = color
    ESP_Solid.OutlineTransparency = 0
    ESP_Solid.Adornee = Character
end

local function RemoveESP(player)
    local Character = player.Character
    if Character then
        local ESP_Solid = Character:FindFirstChild("ESP_Solid")
        if ESP_Solid then ESP_Solid:Destroy() end
    end
end
Players.PlayerRemoving:Connect(RemoveESP)

