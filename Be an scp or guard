local function ResetSCPHitboxes()
    for player, originalData in pairs(OriginalSCPHitboxes) do
        local Character = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
        if Character and originalData then
            Character.Size = originalData.Size
            Character.Transparency = originalData.Transparency
            Character.Material = originalData.Material
            Character.BrickColor = originalData.BrickColor
            Character.CanCollide = originalData.CanCollide
        end
    end
    table.clear(OriginalSCPHitboxes)
end

local function ResetGuardHitboxes()
    for player, originalData in pairs(OriginalGuardHitboxes) do
        local Character = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
