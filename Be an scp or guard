local function isValidTarget(target)
    if not target or target == LocalPlayer then return false end
    local team = LocalPlayer.Team and LocalPlayer.Team.Name
    local targetTeam = target.Team and target.Team.Name
    if not team or not targetTeam then return false end
    local v119 = teamCheck1[team]
    if v119 then return not v119[targetTeam] end
    return team ~= targetTeam
end

local function getLowestHpTarget()
    local targetChar
    local lowestHp = 1e999
    for _, player in ipairs(Players:GetPlayers()) do
        if isValidTarget(player) then
            local char = player.Character
            local hum = char and char:FindFirstChildOfClass("Humanoid")
            local root = char and char:FindFirstChild("HumanoidRootPart")
            local head = char and char:FindFirstChild("Head")
            if hum and root and head and hum.Health > 0 and hum.Health < lowestHp then
                lowestHp = hum.Health
                targetChar = char
            end
        end
    end
    return targetChar
end

