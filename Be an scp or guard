-- Logic Auto Kill (Closest Target)
local function getClosestTarget()
    local targetChar
    local shortestDist = 1e999
    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return nil end
    for _, player in ipairs(Players:GetPlayers()) do
        if isValidTarget(player) then
            local pChar = player.Character
            local hum = pChar and pChar:FindFirstChildOfClass("Humanoid")
            local pRoot = pChar and pChar:FindFirstChild("HumanoidRootPart")
            local head = pChar and pChar:FindFirstChild("Head")
            if hum and pRoot and head and hum.Health > 0 then
                local dist = (root.Position - pRoot.Position).Magnitude
                if dist < shortestDist then
                    shortestDist = dist
                    targetChar = pChar
                end
            end
        end
    end
    return targetChar
end

