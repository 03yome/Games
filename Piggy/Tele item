-- Hàm lấy tọa độ CFrame của item
local function getTargetCFrame(item)
	if item:IsA("BasePart") then
		return item.CFrame
	elseif item:IsA("Model") then
		if item.PrimaryPart then
			return item.PrimaryPart.CFrame
		else
			local part = item:FindFirstChildWhichIsA("BasePart", true)
			if part then return part.CFrame end
		end
	end
	return nil
end

-- Hàm cập nhật lại danh sách các item lên giao diện
local function updateList()
	-- Xóa các nút cũ trước khi quét mới
	for _, child in ipairs(scrollingFrame:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	-- Quét đệ quy tạo nút bấm cho từng item
	local function scanFolderForGui(parentFolder)
		for _, item in ipairs(parentFolder:GetChildren()) do
			if item:IsA("BasePart") or item:IsA("Model") then
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, 0, 0, 32)
				btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
				btn.TextColor3 = Color3.fromRGB(255, 255, 255)
				-- Ưu tiên hiển thị tên gốc nếu có StringValue
				local origName = item:FindFirstChild("OriginalName")
				btn.Text = origName and origName.Value or item.Name
				btn.TextSize = 13
				btn.Font = Enum.Font.SourceSans
				
				-- Sự kiện bấm vào tên item để dịch chuyển đến đó
				btn.MouseButton1Click:Connect(function()
					local cframe = getTargetCFrame(item)
					if cframe then
						local char = localPlayer.Character
						if char and char:FindFirstChild("HumanoidRootPart") then
							char.HumanoidRootPart.CFrame = cframe + Vector3.new(0, 3, 0)
						end
					end
				end)
				
				btn.Parent = scrollingFrame
			elseif item:IsA("Folder") then
				scanFolderForGui(item)
			end
		end
	end

	scanFolderForGui(itemFolder)
end

-- Gắn sự kiện cho nút Làm mới
refreshBtn.MouseButton1Click:Connect(updateList)

-- Chạy lần đầu tiên khi bật script
updateList()
