	warn("Không tìm thấy Workspace.ItemFolder trong game!")
	return
end

-- ==================== PHẦN 1: BACKUP VÀ BẢO VỆ TÊN GỐC ====================
local function setupItem(item)
	-- Kiểm tra và tạo StringValue lưu tên gốc
	local originalNameVal = item:FindFirstChild("OriginalName")
	if not originalNameVal then
		originalNameVal = Instance.new("StringValue")
		originalNameVal.Name = "OriginalName"
		originalNameVal.Value = item.Name
		originalNameVal.Parent = item
	end

	-- Lắng nghe nếu tên bị thay đổi thì trả lại tên gốc
	item:GetPropertyChangedSignal("Name"):Connect(function()
		if item.Name ~= originalNameVal.Value then
			item.Name = originalNameVal.Value
		end
	end)
end

-- Hàm đệ quy quét toàn bộ item trong ItemFolder và thư mục con
local function scanAndSetupFolder(folder)
	for _, item in ipairs(folder:GetChildren()) do
		if item:IsA("BasePart") or item:IsA("Model") then
			setupItem(item)
		elseif item:IsA("Folder") then
			scanAndSetupFolder(item)
		end
	end
end

-- Thiết lập ban đầu cho các item hiện có
scanAndSetupFolder(itemFolder)

-- Lắng nghe khi có item mới hoặc thư mục con mới được thêm vào
itemFolder.DescendantAdded:Connect(function(descendant)
	if descendant:IsA("BasePart") or descendant:IsA("Model") then
		setupItem(descendant)
	end
end)


