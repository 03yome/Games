local EspFolder = workspace:FindFirstChild("TableESP_Holder") or Instance.new("Folder", workspace)
EspFolder.Name = "TableESP_Holder"

local function toggleTableEsp(isEnabled)
    EspFolder:ClearAllChildren()
    if not isEnabled then return end
    
    local duelTables = workspace:FindFirstChild("DuelTables")
    if not duelTables then return end

    for _, tableModel in ipairs(duelTables:GetChildren()) do
        if tableModel.Name:match("^Table_%d+") then
            local adornee = tableModel.PrimaryPart or tableModel:FindFirstChildWhichIsA("BasePart", true)
            if adornee then
                local billboard = Instance.new("BillboardGui")
                billboard.Name = "TableESP"
                billboard.Size = UDim2.new(0, 150, 0, 50)
                billboard.AlwaysOnTop = true
                billboard.Adornee = adornee
                billboard.StudsOffset = Vector3.new(0, 3, 0)
                billboard.Parent = EspFolder

                local textLbl = Instance.new("TextLabel")
                textLbl.Size = UDim2.new(1, 0, 1, 0)
                textLbl.BackgroundTransparency = 1
                textLbl.Text = tableModel.Name:gsub("_", " ")
                textLbl.TextColor3 = Color3.fromRGB(0, 255, 185)
                textLbl.Font = Enum.Font.GothamBold
                textLbl.TextSize = 14
                textLbl.TextStrokeTransparency = 0
                textLbl.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
                textLbl.Parent = billboard
            end
        end
    end
end

_G.AutoRevealTiles = false
_G.AutoTextDetector = false
_G.AutoGuessAnswer = false
_G.TableESPEnabled = false
_G.GuessDelayValue = 0
_G.StreamerMode = false
_G.AntiAFKEnabled = false

local lastGuessedText = ""

task.spawn(function()
    while true do
        local currentTable, playerSeatType = getNearestDuelTable()
        
        if currentTable and playerSeatType then
            local board1Name, board1Id = getBoardText(currentTable, 1)
            local board2Name, board2Id = getBoardText(currentTable, 2)
            
            local myGameName, opponentGameName, myTargetId = "", "", nil
            
            if playerSeatType == 1 then
                myGameName = board1Name
                opponentGameName = board2Name
                myTargetId = board1Id
            else
                myGameName = board2Name
                opponentGameName = board1Name
                myTargetId = board2Id
            end

            if _G.AutoTextDetector then
                if _G.StreamerMode then
                    StatusLabel:Set("🏢 Table: [HIDDEN]  |  👤 Me: [PROTECTED]  |  😈 Opponent: " .. opponentGameName)
                else
                    StatusLabel:Set("🏢 " .. currentTable.Name:gsub("_", " ") .. "  |  👤 Me: " .. myGameName .. "  |  😈 Opponent: " .. opponentGameName)
                end
            end

            if _G.AutoGuessAnswer and myTargetId and GameData[myTargetId] then
                if isGuessMenuOpen() and lastGuessedText ~= opponentGameName and opponentGameName ~= "Choosing..." then
                    lastGuessedText = opponentGameName
                    task.spawn(function()
                        pcall(function()
                            local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                            if remotes then
                                local startRemote = remotes:FindFirstChild("PlayerGuessStart")
                                local guessedRemote = remotes:FindFirstChild("PlayerGuessed")
                                
                                if startRemote and guessedRemote then
                                    startRemote:FireServer()
                                    if _G.GuessDelayValue and _G.GuessDelayValue > 0 then
                                        task.wait(_G.GuessDelayValue)
                                    else
                                        task.wait(0.15)
                                    end
                                    guessedRemote:FireServer(GameData[myTargetId])
                                end
                            end
                        end)
                    end)
                end
            end
        else
            if _G.AutoTextDetector then
                StatusLabel:Set("🎯 Live Display: Please sit down at any Table...")
            end
            lastGuessedText = ""
        end

        if _G.AutoRevealTiles and currentTable then
            pcall(function()
                applyTileReveal(currentTable)
            end)
        end

        -- Update Reveal Games Tab (All Tables Overview)
        local duelTablesFolder = workspace:FindFirstChild("DuelTables")
        if duelTablesFolder then
            for i = 1, 18 do
                local tableInstance = duelTablesFolder:FindFirstChild("Table_" .. i)
                if tableInstance and TableParagraphs[i] then
                    local b1Name = getBoardText(tableInstance, 1)
                    local b2Name = getBoardText(tableInstance, 2)
                    TableParagraphs[i]:Set({
                        Title = "🏢 Table " .. i,
                        Content = "🎮 Board 1 Reveal Game: " .. b1Name .. "\n🎮 Board 2 Reveal Game: " .. b2Name,
                    })
                end
            end
        end

        task.wait(0.5)
    end
end)

