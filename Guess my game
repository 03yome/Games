local function getBoardType(targetInstance)
    local currentParent = targetInstance
    while currentParent and currentParent ~= workspace do
        local nameLower = currentParent.Name:lower()
        if nameLower:find("board1") or nameLower == "b1" or nameLower:find("board1grid") then
            return 1
        elseif nameLower:find("board2") or nameLower == "b2" or nameLower:find("board2grid") then
            return 2
        end
        currentParent = currentParent.Parent
    end
    return nil
end

local function getBoardText(container, expectedBoardType)
    if not container then return "Choosing...", nil end
    
    for _, desc in ipairs(container:GetDescendants()) do
        local boardImageId = desc:GetAttribute("BoardImageId")
        if boardImageId then
            local boardType = getBoardType(desc)
            if boardType == expectedBoardType then
                local idStr = string.match(tostring(boardImageId), "%d+")
                if idStr then
                    if GameNames[idStr] then
                        return GameNames[idStr], idStr
                    else
                        return "ID: " .. idStr, idStr
                    end
                end
            end
        end
    end
    return "Choosing...", nil
end

local function getNearestDuelTable()
    local character = LocalPlayer.Character
    if not character then return nil, nil end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil, nil end

    local duelTables = workspace:FindFirstChild("DuelTables")
    if not duelTables then return nil, nil end

    local nearestTable = nil
    local shortestDistance = math.huge

    for _, tableModel in ipairs(duelTables:GetChildren()) do
        if tableModel.Name:match("^Table_%d+") then
            local primaryPart = tableModel.PrimaryPart or tableModel:FindFirstChildWhichIsA("BasePart", true)
            if primaryPart then
                local dist = (rootPart.Position - primaryPart.Position).Magnitude
                if dist < shortestDistance and dist < 30 then
                    shortestDistance = dist
                    nearestTable = tableModel
                end
            end
        end
    end

    if nearestTable then
        local humanoid = character:FindFirstChildOfClass("Humanoid")
        if humanoid and humanoid.SeatPart then
            local seatBoardType = getBoardType(humanoid.SeatPart)
            if seatBoardType then
                return nearestTable, seatBoardType
            end
            return nearestTable, 1 -- Default fallback
        end
        
        local b1Opt = nearestTable:FindFirstChild("Board1Grid") or nearestTable:FindFirstChild("Board1", true)
        local b2Opt = nearestTable:FindFirstChild("Board2Grid") or nearestTable:FindFirstChild("Board2", true)
        
        local p1 = b1Opt and (b1Opt:IsA("BasePart") and b1Opt or b1Opt:FindFirstChildWhichIsA("BasePart", true))
        local p2 = b2Opt and (b2Opt:IsA("BasePart") and b2Opt or b2Opt:FindFirstChildWhichIsA("BasePart", true))
        
        if p1 and p2 then
            local dist1 = (rootPart.Position - p1.Position).Magnitude
            local dist2 = (rootPart.Position - p2.Position).Magnitude
            return nearestTable, (dist1 < dist2 and 1 or 2)
        end
        return nearestTable, 1
    end

    return nil, nil
end

local function isGuessMenuOpen()
    local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
    if not playerGui then return false end
    local gameUi = playerGui:FindFirstChild("GameUI")
    if not gameUi then return false end
    local menus = gameUi:FindFirstChild("Menus")
    if not menus then return false end
    local guessOrSkip = menus:FindFirstChild("GuessOrSkip")
    if not guessOrSkip or not guessOrSkip.Visible then return false end
    
    local buttonSort = guessOrSkip:FindFirstChild("ButtonSort")
    if not buttonSort then return false end
    local guessButton = buttonSort:FindFirstChild("GuessButton")
    
    return guessButton and guessButton.Visible
end

local function applyTileReveal(tableInstance)
    if not tableInstance then return end
    for _, item in ipairs(tableInstance:GetDescendants()) do
        if item:IsA("BasePart") and item.Parent and (item.Parent.Name:match("Grid$") or item.Name:match("Tile")) then
            item.Transparency = 1
            for _, child in ipairs(item:GetChildren()) do
                if child:IsA("Decal") then
                    child.Transparency = 1
                end
            end
            local surfaceGui = item:FindFirstChildWhichIsA("SurfaceGui")
            if surfaceGui then
                for _, guiChild in ipairs(surfaceGui:GetChildren()) do
                    if guiChild:IsA("ImageLabel") or guiChild:IsA("TextLabel") then
                        guiChild.Visible = (guiChild.Name == "CharacterImage")
                    end
                end
            end
        end
    end
end

