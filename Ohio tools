    local localCharacter = getLocalCharacter()
    local localRoot =
        localCharacter and localCharacter:FindFirstChild("HumanoidRootPart")

    if not localRoot or not targetRoot then
        return 0
    end

    return math.floor(
        (localRoot.Position - targetRoot.Position).Magnitude
    )
