        -- Health bar
        local healthBar = Instance.new("Frame")
        healthBar.Name = "HealthBar"
        healthBar.Size = UDim2.fromScale(1, 1)
        healthBar.BackgroundColor3 = Color3.fromRGB(0, 255, 0)
        healthBar.BorderSizePixel = 0
        healthBar.Parent = healthBackground

        data.HealthBar = healthBar

        local function updateESP()
            if not character.Parent then
                return
            end

            local healthPercent = 0

            if humanoid.MaxHealth > 0 then
                healthPercent =
                    humanoid.Health / humanoid.MaxHealth
            end

            healthPercent =
                math.clamp(healthPercent, 0, 1)

            if data.DistanceLabel then
                data.DistanceLabel.Text =
                    tostring(
                        getDistanceFromLocalPlayer(root)
                    ) .. " m"
            end

            if data.HealthBar then
                data.HealthBar.Size =
                    UDim2.new(
                        healthPercent,
                        0,
                        1,
                        0
                    )

                data.HealthBar.BackgroundColor3 =
                    getHealthColor(healthPercent)
            end

            if data.Highlight then
                data.Highlight.Enabled =
                    ESPEnabled and ShowHighlight

                data.Highlight.FillColor =
                    HighlightColor
            end

            if data.Billboard then
                data.Billboard.Enabled =
                    ESPEnabled
            end

            if data.NameLabel then
                data.NameLabel.Visible = ShowName
                data.NameLabel.TextColor3 = TextColor
            end

            if data.DistanceLabel then
                data.DistanceLabel.Visible =
                    ShowDistance

                data.DistanceLabel.TextColor3 =
                    TextColor
            end

            if data.HealthBackground then
                data.HealthBackground.Visible =
                    ShowHealthBar
            end
        end

        data.HealthConnection =
            humanoid.HealthChanged:Connect(updateESP)

        data.UpdateConnection =
            game:GetService("RunService").RenderStepped:Connect(
                updateESP
            )

        updateESP()
    end

    if player.Character then
        setupCharacter(player.Character)
    end

    data.CharacterConnection =
        player.CharacterAdded:Connect(function(character)
            task.wait(0.1)
            setupCharacter(character)
        end)
end

local function refreshESP()
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            if ESPEnabled then
                createESP(player)
            else
                removeESP(player)
            end
        end
    end
end

Players.PlayerAdded:Connect(function(player)
    if ESPEnabled then
        createESP(player)
    end
end)

Players.PlayerRemoving:Connect(function(player)
    removeESP(player)
end)

