local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local localPlayer = Players.LocalPlayer

local debrisFolder = Workspace:WaitForChild("DebrisFolder", 5)

if not debrisFolder then
    warn("Không tìm thấy DebrisFolder trong Workspace!")
    return
end

local collectedItems = {}

local function collectItems()
    local character = localPlayer.Character
    if not character then return end
    
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    for _, item in ipairs(debrisFolder:GetChildren()) do
        if item:IsA("BasePart") and not collectedItems[item] then
            
            local touchInterest = item:FindFirstChildWhichIsA("TouchTransmitter") or item:FindFirstChild("TouchInterest")
            
            if touchInterest then
                collectedItems[item] = true
                
                local success, err = pcall(function()
                    firetouchinterest(rootPart, item, 0)
                    task.wait()
                    firetouchinterest(rootPart, item, 1)
                end)
                
                if not success then
                    warn("Lỗi firetouchinterest: " .. tostring(err))
                end
            end
        end
    end
end

task.spawn(function()
    while true do
        for item, _ in pairs(collectedItems) do
            if not item or not item.Parent or not item:IsDescendantOf(debrisFolder) then
                collectedItems[item] = nil
            end
        end
        task.wait(1)
    end
end)

task.spawn(function()
    while true do
        pcall(collectItems)
        task.wait(0.2)
    end
end)
