-- ESP Machine Setup
local espFolder = Instance.new("Folder")
espFolder.Name = "ESP_Container"
espFolder.Parent = workspace
local espConnections = {}

local function clearMachineESP()
    espFolder:ClearAllChildren()
    for _, conn in ipairs(espConnections) do
        conn:Disconnect()
    end
    table.clear(espConnections)
end

local function addMachineESP(machine)
    local model = machine:FindFirstChild("Model")
    if not model then return end
    local screen = model:FindFirstChild("Screen")
    if not screen or not screen:IsA("BasePart") then return end

    if espFolder:FindFirstChild(machine.Name .. "_ESP") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = machine.Name .. "_ESP"
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = Color3.new(1, 1, 1)
    highlight.Adornee = model
    highlight.Parent = espFolder

    local function updateColor()
        if screen then
            highlight.FillColor = screen.Color
        end
    end
    updateColor()
    table.insert(espConnections, screen:GetPropertyChangedSignal("Color"):Connect(updateColor))
end

local function initMachineESP()
    local machines = workspace:FindFirstChild("Machines", true)
    if not machines then return end

    for _, child in ipairs(machines:GetChildren()) do
        if child:IsA("Model") then
            addMachineESP(child)
        end
    end

    table.insert(espConnections, machines.ChildAdded:Connect(function(child)
        if espMachineEnabled then
            task.wait()
            addMachineESP(child)
        end
    end))
end

Tab:CreateToggle({
    Name = "ESP Machine",
