-- Chức năng Auto Revive (Cố định nhẹ bằng PlatformStand hoặc Velocity để tránh lỗi rớt map và không bị khóa cứng chân)
Tab:CreateToggle({
    Name = "Auto Revive",
    CurrentValue = false,
    Flag = "AutoRevive",
    Callback = function(Value)
        autoReviveEnabled = Value
        local hrp = getHRP()

        if Value then
            if hrp then
                oldPosition = hrp.CFrame
            end
            
            -- Bật Noclip để tránh kẹt
            noclipConnection = game:GetService("RunService").Stepped:Connect(function()
                if LocalPlayer.Character then
                    for _, part in ipairs(LocalPlayer.Character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)
        else
            -- Tắt: Trả player lại chỗ cũ và tắt Noclip
            if noclipConnection then
                noclipConnection:Disconnect()
                noclipConnection = nil
            end
            if hrp then
                hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                if oldPosition then 
                    hrp.CFrame = oldPosition 
                end
            end
            oldPosition = nil
        end
    end,
})

-- Vòng lặp xử lý Auto Revive (Teleport nhẹ nhàng, giữ Velocity bằng 0 tạm thời để đứng yên thay vì dùng Anchored)
task.spawn(function()
    while true do
        if autoReviveEnabled then
            pcall(function()
                local targetPrompt = nil
                local targetPlayer = nil

                for _, player in ipairs(Players:GetPlayers()) do
                    if player ~= LocalPlayer and player.Character then
                        local char = player.Character
                        for _, desc in ipairs(char:GetDescendants()) do
                            if desc:IsA("ProximityPrompt") then
                                local actionText = string.lower(desc.ActionText or "")
                                local objectText = string.lower(desc.ObjectText or "")
                                local promptName = string.lower(desc.Name or "")
                                
                                if actionText:find("revive") or objectText:find("revive") or actionText:find("cứu") or objectText:find("cứu") or promptName:find("revive") then
                                    targetPrompt = desc
                                    targetPlayer = char
                                    break
                                end
                            end
                        end
                    end
                    if targetPrompt then break end
                end

                local hrp = getHRP()
                if targetPrompt and targetPlayer and hrp then
                    local targetHrp = targetPlayer:FindFirstChild("HumanoidRootPart") or targetPlayer:FindFirstChild("Head")
                    if targetHrp then
                        -- Cố định nhẹ vị trí bằng cách gán CFrame liên tục dưới chân player mục tiêu và triệt tiêu vận tốc rơi
                        hrp.CFrame = targetHrp.CFrame * CFrame.new(0, -3, 0)
                        hrp.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                        
                        -- Chỉnh prompt về 0 cooldown và spam fire
                        targetPrompt.HoldDuration = 0
                        fireproximityprompt(targetPrompt, 0)
                    end
                end
            end)
        end
        task.wait(0.1)
    end
end)

