-- Hàm lấy HumanoidRootPart của LocalPlayer
local function getHRP()
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    return character:FindFirstChild("HumanoidRootPart")
end

-- Hàm thu thập vật phẩm (Coin)
local function fireItem(item)
    if not collectCoinEnabled or not item or not item:IsA("BasePart") or not item.Parent or not item:IsDescendantOf(workspace) or collectedItems[item] then
        return
    end

    local hrp = getHRP()
    if not hrp or not hrp.Parent then return end

    collectedItems[item] = true
    pcall(function()
        firetouchinterest(hrp, item, 0)
        task.wait()
        firetouchinterest(hrp, item, 1)
    end)
end

local function setupItemsFolder(folder)
    if not folder:IsA("Folder") or not folder.Name:find("Items") then return end

    for _, v in ipairs(folder:GetDescendants()) do
        if v:IsA("BasePart") then
            task.spawn(fireItem, v)
        end
    end

    table.insert(collectCoinConnections, folder.DescendantAdded:Connect(function(descendant)
        if collectCoinEnabled and descendant:IsA("BasePart") then
            task.spawn(fireItem, descendant)
        end
    end))
end

