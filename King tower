        frame.Visible = (index == targetIndex)
    end
    for index, button in ipairs(tabButtonsList) do
        if index == targetIndex then
            TweenService:Create(button, TweenInfo.new(0.15), {
				BackgroundColor3 = Color3.fromRGB(100, 40, 200),
				TextColor3 = Color3.fromRGB(255, 255, 255)
			}):Play()
