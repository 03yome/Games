-- Kill Brick Protection Logic
createMenuLabel(extraTab, "KILL BRICK PROTECTION", 1)
local protectionToggleButton, protectionStroke = createMenuButton(extraTab, "PROTECTION : OFF", 2)
local protectedKillBricks = {}
local isProtectionEnabled = false

local function clearKillBrickProtection()
    for _, data in pairs(protectedKillBricks) do
        local partParent = data.Part and data.Part.Parent
        if partParent then
            data.Part.CanTouch = true
            data.Part.Color = data.OldColor
            data.Part.Material = data.OldMaterial
        end
    end
    table.clear(protectedKillBricks)
end

local function applyKillBrickProtection()
    clearKillBrickProtection()
    for _, descendant in pairs(workspace:GetDescendants()) do
        if descendant:IsA("BasePart") and descendant.Name == "KillBrick" and not descendant:IsA("SpawnLocation") then
            table.insert(protectedKillBricks, {
				Part = descendant,
				OldColor = descendant.Color,
				OldMaterial = descendant.Material
			})
            descendant.CanTouch = false
            descendant.Color = Color3.fromRGB(255, 0, 0)
            descendant.Material = Enum.Material.Neon
        end
    end
end

protectionToggleButton.MouseButton1Click:Connect(function()
    isProtectionEnabled = not isProtectionEnabled
    if isProtectionEnabled then
        protectionToggleButton.Text = "PROTECTION : ON"
        protectionToggleButton.BackgroundColor3 = Color3.fromRGB(50, 80, 50)
        protectionStroke.Color = Color3.fromRGB(80, 200, 80)
        applyKillBrickProtection()
        return
    end
    protectionToggleButton.Text = "PROTECTION : OFF"
    protectionToggleButton.BackgroundColor3 = Color3.fromRGB(25, 25, 45)
    protectionStroke.Color = Color3.fromRGB(60, 40, 140)
    clearKillBrickProtection()
end)

