local isSpinEnabled = false
local isAutoAimEnabled = false
local spinAngle = 1.5707963267948966

local function setRagdollState(isEnabled)
    local targetCharacter = localPlayer.Character
    local hum = targetCharacter and targetCharacter:FindFirstChild("Humanoid")
    if not hum then return end
    hum:SetStateEnabled(Enum.HumanoidStateType.FallingDown, not isEnabled)
    hum:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, not isEnabled)
end

local function updateRagdollState()
    setRagdollState(isSpinEnabled or isAutoAimEnabled)
end

local function getClosestPlayerRootPart()
    local targetCharacter = localPlayer.Character
    if not targetCharacter then return nil end
    local rootPart = targetCharacter:FindFirstChild("HumanoidRootPart")
    if not rootPart then return nil end

    local closestRootPart = nil
    local shortestDistance = 1e999
    for _, player in pairs(Players:GetPlayers()) do
        if player ~= localPlayer and player.Character then
            local enemyRootPart = player.Character:FindFirstChild("HumanoidRootPart")
            if enemyRootPart then
                local distance = (rootPart.Position - enemyRootPart.Position).Magnitude
                if distance < shortestDistance then
                    closestRootPart = enemyRootPart
                    shortestDistance = distance
                end
            end
        end
    end
    return closestRootPart
end

RunService.RenderStepped:Connect(function()
    local targetCharacter = localPlayer.Character
    local rootPart = targetCharacter and targetCharacter:FindFirstChild("HumanoidRootPart")
    if not rootPart then return end

    if isAutoAimEnabled then
        local targetRootPart = getClosestPlayerRootPart()
        if targetRootPart then
            local targetPosition = Vector3.new(targetRootPart.Position.X, rootPart.Position.Y, targetRootPart.Position.Z)
            rootPart.CFrame = CFrame.new(rootPart.Position, targetPosition)
            return
        end
    elseif isSpinEnabled then
        rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, spinAngle, 0)
    end
end)

