        autoPathToggleButton.Text = "AUTO : ON"
        autoPathToggleButton.BackgroundColor3 = Color3.fromRGB(50, 80, 50)
        autoPathStroke.Color = Color3.fromRGB(80, 200, 80)
        autoPathStatusLabel.Text = "Status: Running..."
        task.spawn(executeAutoPath)
        return
    end

    autoPathToggleButton.Text = "AUTO : OFF"
    autoPathToggleButton.BackgroundColor3 = Color3.fromRGB(25, 25, 45)
    autoPathStroke.Color = Color3.fromRGB(60, 40, 140)
    autoPathStatusLabel.Text = "Status: Stopped"
end)

