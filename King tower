local function glideToPosition(targetPosition)
    local currentRootPart = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not currentRootPart then return end

    local attachment = Instance.new("Attachment")
    attachment.Parent = currentRootPart

    local linearVelocity = Instance.new("LinearVelocity")
    linearVelocity.Parent = currentRootPart
    linearVelocity.Attachment0 = attachment
    linearVelocity.RelativeTo = Enum.ActuatorRelativeTo.World
    linearVelocity.MaxForce = math.huge

    while isAutoPathRunning do
        local direction = targetPosition - currentRootPart.Position
        local distance = direction.Magnitude
        if distance > 0 then
            direction = direction.Unit
        end

        linearVelocity.VectorVelocity = direction * moveSpeed
        currentRootPart.CFrame = CFrame.lookAt(currentRootPart.Position, currentRootPart.Position + Vector3.new(direction.X, 0, direction.Z))
        task.wait()

        if distance < 4 then
            break
        end
    end

    linearVelocity:Destroy()
    attachment:Destroy()
end

local function executeAutoPath()
    for index, waypoint in ipairs(waypointsList) do
        if not isAutoPathRunning then break end
        autoPathStatusLabel.Text = "Progress: " .. index .. "/" .. #waypointsList
        glideToPosition(waypoint.Position)
        task.wait(0.05)
    end

    if isAutoPathRunning then
        isAutoPathRunning = false
        autoPathToggleButton.Text = "AUTO : OFF"
        autoPathToggleButton.BackgroundColor3 = Color3.fromRGB(25, 25, 45)
        autoPathStroke.Color = Color3.fromRGB(60, 40, 140)
        autoPathStatusLabel.Text = "Status: Completed"
    end
end

