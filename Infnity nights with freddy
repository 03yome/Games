-- Smart Door
local doorOn,showRay,doorsData,lastCheck=false,true,nil,0
local doorCloseDist=12
local beams={L={},R={}}
local COOLDOWN,CHECK_INT=0.3,0.15
local function clearBeams(side) for _,v in beams[side] do if v and v.Parent then v:Destroy() end end; beams[side]={} end
local function makeBeam(sp,ep,hit,side) if (sp-ep).Magnitude<0.3 then return end; local col=hit and Color3.fromRGB(255,30,30) or Color3.fromRGB(30,255,30); local beam=Instance.new("Beam"); beam.Width0=0.1; beam.Width1=0.1; beam.Color=ColorSequence.new(col); beam.Transparency=NumberSequence.new(0.1); beam.LightEmission=1; beam.Texture="rbxassetid://251083625"; beam.TextureLength=1; beam.FaceCamera=false; local a0=Instance.new("Attachment"); a0.WorldCFrame=CFrame.new(sp); a0.Parent=Workspace.Terrain; local a1=Instance.new("Attachment"); a1.WorldCFrame=CFrame.new(ep); a1.Parent=Workspace.Terrain; beam.Attachment0=a0; beam.Attachment1=a1; beam.Parent=Workspace.Terrain; table.insert(beams[side],beam); table.insert(beams[side],a0); table.insert(beams[side],a1); local ball=Instance.new("Part"); ball.Size=Vector3.new(0.4,0.4,0.4); ball.CFrame=CFrame.new(ep); ball.Anchored=true; ball.CanCollide=false; ball.Material=Enum.Material.Neon; ball.Shape=Enum.PartType.Ball; ball.BrickColor=hit and BrickColor.new("Bright red") or BrickColor.new("Bright green"); ball.Transparency=0.2; ball.Parent=Workspace; table.insert(beams[side],ball); Debris:AddItem(beam,0.2); Debris:AddItem(a0,0.2); Debris:AddItem(a1,0.2); Debris:AddItem(ball,0.2) end
local function checkDoor(side,doorPos,doorX) local anims=Workspace:FindFirstChild("Animatronics"); if not anims then return false end; if showRay then clearBeams(side) end; local offX=(side=="L") and -1 or 1; local rs=doorPos+Vector3.new(offX,0,0); for _,a in anims:GetChildren() do if a:IsA("Model") then local pp=a.PrimaryPart; if pp then local ax=pp.Position.X; if (side=="L" and ax<doorX) or (side=="R" and ax>doorX) then local dist=(pp.Position-doorPos).Magnitude; local hit=dist<=doorCloseDist; if showRay then local dir=(pp.Position-rs).Unit; makeBeam(rs,rs+dir*math.min(dist,50),hit,side) end; if hit then return true end end end end end; return false end
local function setupDoors() local dc=Workspace:WaitForChild("Map"):WaitForChild("Doors"); local d=dc:GetChildren(); local ld,rd=nil,nil; for _,door in d do if door.Name=="Door" then if not ld then ld=door else rd=door; break end end end; if not ld or not rd then return nil end; return {L={door=ld,root=ld:WaitForChild("RootPart"),prompt=ld:WaitForChild("Button"):WaitForChild("ProximityPrompt"),lastAct=0,closed=false},R={door=rd,root=rd:WaitForChild("RootPart"),prompt=rd:WaitForChild("Button"):WaitForChild("ProximityPrompt"),lastAct=0,closed=false}} end
local function fireDoor(dd) local n=tick(); if n-dd.lastAct<COOLDOWN then return false end; fireproximityprompt(dd.prompt); dd.lastAct=n; return true end
local function doDoor() local n=tick(); if n-lastCheck<CHECK_INT then return end; lastCheck=n; if not doorsData then doorsData=setupDoors(); if not doorsData then return end end; doorsData.L.closed=doorsData.L.door:GetAttribute("Closed") or false; doorsData.R.closed=doorsData.R.door:GetAttribute("Closed") or false; local ln=checkDoor("L",doorsData.L.root.Position,doorsData.L.root.Position.X); if ln and not doorsData.L.closed then fireDoor(doorsData.L) elseif not ln and doorsData.L.closed then fireDoor(doorsData.L) end; local rn=checkDoor("R",doorsData.R.root.Position,doorsData.R.root.Position.X); if rn and not doorsData.R.closed then fireDoor(doorsData.R) elseif not rn and doorsData.R.closed then fireDoor(doorsData.R) end end

