-- Auto Escape (retry until EscapeHighlight disabled)
local escOn,escPlat,escFired=false,nil,false
local function escPlatform(c) if escPlat then escPlat:Destroy() end; local hrp=c and c:FindFirstChild("HumanoidRootPart"); if not hrp then return end; escPlat=Instance.new("Part"); escPlat.Name="EscPlat"; escPlat.Size=Vector3.new(4,1,4); escPlat.Anchored=true; escPlat.CanCollide=true; escPlat.Transparency=0.5; escPlat.Color=Color3.fromRGB(0,255,0); escPlat.Material=Enum.Material.Neon; escPlat.CFrame=CFrame.new(hrp.Position.X,hrp.Position.Y-3,hrp.Position.Z); escPlat.Parent=Workspace end
local function clearEscPlat() if escPlat then escPlat:Destroy(); escPlat=nil end end
local function doEscape()
    if not needAC() then escOn=false; return end
    local c=player.Character; if not c then return end
    local hrp=c:FindFirstChild("HumanoidRootPart"); if not hrp then return end
    local escapeHighlight=Workspace.Map.ImportantSpots.EndPos:FindFirstChild("EscapeHighlight")
    if not escapeHighlight or not escapeHighlight.Enabled then escFired=false; return end
    if not escFired then
        escFired=true
        local ep=Workspace.Map.ImportantSpots.EndPos
        local epr=ep:FindFirstChild("ProximityPrompt"); if not epr then return end
        hrp.CFrame=ep.CFrame*CFrame.new(0,0,-3); escPlatform(c)
        repeat
            fireproximityprompt(epr)
            task.wait(0.1)
            escapeHighlight=Workspace.Map.ImportantSpots.EndPos:FindFirstChild("EscapeHighlight")
        until not escapeHighlight or not escapeHighlight.Enabled or not escOn
        clearEscPlat()
    end
end

