AutoTab:CreateToggle({Name="AUTO FUSEBOXES",CurrentValue=false,Callback=function(v) fuseOn=v; if fuseOn then if not needAC() then fuseOn=false; return end; fuseOldPos=nil; curFuse=nil; fuseNotified=false; doFuse(); spawn(function() while fuseOn do doFuse(); task.wait(0.3) end end) else fuseOldPos=nil; curFuse=nil; fuseNotified=false end end})
AutoTab:CreateToggle({Name="INFINITE CASH",CurrentValue=false,Callback=function(v) cashOn=v; if cashOn then if not needAC() then cashOn=false; return end; spawn(function() while cashOn do pcall(doCash) end end) end end})
