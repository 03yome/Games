local SimpleLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/IcantAffordSynapse/SimpleLib/refs/heads/main/SimpleLib.lua"))()
local Window = SimpleLib:Window("Train rng")

local Tab1 = Window:AddSection("Mod")

local autoAddCash = false
local autoAddTix = false

Tab1:Toggle("Auto Add Cash", false, function(bool)
    autoAddCash = bool
    print("Auto Add Cash:", bool)

    if autoAddCash then
        task.spawn(function()
            while autoAddCash do
                local ReplicatedStorage = game:GetService("ReplicatedStorage")
                local addCashEvent = ReplicatedStorage:FindFirstChild("AddCash")

                if addCashEvent then
                    local args = { "Cash", 20 }
                    addCashEvent:FireServer(unpack(args))
                    print("Added 20 Cash!")
                else
                    warn("AddCash event not found!")
                end

                task.wait(0.5)
            end
        end)
    end
end)

