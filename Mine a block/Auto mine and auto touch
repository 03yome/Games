local function getHRP()
	local char = player.Character
	if not char then return end
	return char:FindFirstChild("HumanoidRootPart")
end

RunService.RenderStepped:Connect(function()
	-- KIỂM TRA NGAY LẬP TỨC: Nếu tắt thì dừng hẳn hàm, không chạy code phía dưới
	if not enabled then return end
	
	local hrp = getHRP()
	if not hrp then return end
	
	for _,block in ipairs(blocksFolder:GetChildren()) do
		-- Kiểm tra thêm 1 lần nữa bên trong vòng lặp để ngắt ngay lập tức nếu trạng thái thay đổi giữa chừng
		if not enabled then break end
		
		local part
		
		if block:IsA("BasePart") then
			part = block
		else
			part = block:FindFirstChildWhichIsA("BasePart")
		end
		
		if part then
			local pos = part.Position
			local myPos = hrp.Position
			
			-- Kiểm tra vùng 3x3 quanh player theo chiều ngang
			local checkX = math.abs(pos.X - myPos.X) <= range
			local checkZ = math.abs(pos.Z - myPos.Z) <= range
			
			-- GIỚI HẠN TRỤC Y THEO CỠ BLOCK 3x3x3:
			local checkY = pos.Y >= (myPos.Y - 4.5)
			
			if checkX and checkZ and checkY then
				local blockId = tonumber(block.Name)
				
				if blockId then
					mineRemote:FireServer(blockId, 948)
				end
			end
		end
	end
end)

