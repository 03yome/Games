local Players = game:GetService("Players")
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui")
gui.Name = "TouchInterestGUI"
gui.ResetOnSpawn = false
gui.Parent = game.CoreGui

local button = Instance.new("TextButton")
button.Size = UDim2.new(0, 180, 0, 50)
button.Position = UDim2.new(0.5, -90, 0, 10)
button.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
button.TextColor3 = Color3.fromRGB(255, 255, 255)
button.TextSize = 18
button.Text = "Touch Enter"
button.Parent = gui

local corner = Instance.new("UICorner")
corner.CornerRadius = UDim.new(0, 8)
corner.Parent = button

button.MouseButton1Click:Connect(function()
    local character = player.Character or player.CharacterAdded:Wait()
    local root = character:FindFirstChild("HumanoidRootPart")

    local enter = workspace
        :WaitForChild("Plots")
        :WaitForChild("x5_oz6")
        :WaitForChild("Interact")
        :WaitForChild("Enter")

    local touchInterest = enter:FindFirstChild("TouchInterest")

    if root and enter:IsA("BasePart") and touchInterest then
        firetouchinterest(root, enter, 0)
        task.wait(0.1)
        firetouchinterest(root, enter, 1)
    end
end)
