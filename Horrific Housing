           for i = 1, 10 do
               local p = Instance.new("Part")
               p.Size = Vector3.new(10, 1, 10)
               p.Position = Vector3.new(startX + 30 + (i - 1) * 30, startY, startZ)
               p.Anchored = true        
               p.CanCollide = true      
               p.BrickColor = BrickColor.new("Bright green")
               p.Material = Enum.Material.Neon
               p.Parent = workspace
               table.insert(parts, p)
           end
           task.spawn(function()
               while isRunning do
                   for i = 1, 10 do
                       if not isRunning then break end
                       local targetPart = parts[i]
                       if targetPart and rootPart then
                           local dest = CFrame.new(targetPart.Position + Vector3.new(0, 3, 0))
                           rootPart.CFrame = dest
                           currentDest = dest
                       end
                       task.wait(1)
                   end
               end
           end)
           connection = RunService.Heartbeat:Connect(function()
               if isRunning and currentDest and rootPart then
                   rootPart.CFrame = currentDest
                   rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
                   rootPart.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
               end
           end)
       else
           isRunning = false
           
           if connection then
               connection:Disconnect()
               connection = nil
           end
           for _, p in ipairs(parts) do
               if p then p:Destroy() end
           end
           parts = {}
           currentDest = nil

           if humanoid then
               humanoid.PlatformStand = false
           end
           if originalPosition then
               rootPart.CFrame = originalPosition
               originalPosition = nil
           end
       end
   end,
})

