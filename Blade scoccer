local executeBlockAction

local function findBall()
    local Ball = workspace:FindFirstChild("Ball")
    if Ball then
        return Ball
    end

    local getTagged = CollectionService:GetTagged("Ball") -- Hoặc dùng CollectionService nếu cần
    for _, descendant in pairs(workspace:GetDescendants()) do
        if descendant.Name == "Ball" and descendant:IsA("BasePart") then
            return descendant
        end
    end

    return nil
end

local function triggerAbilityEvent()
    if not Library.Toggles.NoDashCooldown.Value then
        return
    end

    if not LocalPlayer.Character then
        return
    end

    ReplicatedStorage.Remotes.AbilityEvent:FireServer()
end

local function processParry()
    if not Library.Toggles.ParryToggle.Value then
        return
    end

    if not targetBall or not targetBall.Parent then
        targetBall = findBall()
    end

    if targetBall and HumanoidRootPart then
        local distance = (targetBall.Position - HumanoidRootPart.Position).Magnitude
        local parryDistance = Library.Options.ParryDistance.Value

        if Library.Toggles.LegitMode.Value then
            parryDistance -= math.random(0, 30) / 10
        end

        local isAutoSpamActive = Library.Toggles.AutoSpam.Value
        if isAutoSpamActive then
            isAutoSpamActive = distance <= Library.Options.SpamDistance.Value
        end

        if isAutoSpamActive then
            executeBlockAction()
            return
        end

        if distance <= parryDistance then
            executeBlockAction()
        end
    end
end

function executeBlockAction()
    task.spawn(function()
        if not Character or not Character.Parent then
            Character = LocalPlayer.Character
            if Character then
                Character:WaitForChild("HumanoidRootPart")
            end
        end

        if Library.Toggles.LegitMode.Value then
            if math.random(1, 100) > 95 then
                task.wait(0.08)
            end
            task.wait(math.random(2, 12) / 100)
        end

        local lookVector = Vector3.new(0, 0, -1)
        if Character and Character.PrimaryPart then
            lookVector = Character.PrimaryPart.CFrame.LookVector
        end

        local serverTime = workspace:GetServerTimeNow()
        local blockRepeat = Library.Options.BlockRepeat.Value or 1
        local blockDelay = Library.Options.BlockDelay.Value or 0.1

        for _ = 1, blockRepeat do
            pcall(function()
                local remotes = ReplicatedStorage:FindFirstChild("Remotes")
                if remotes then
                    local startBlockEvent = remotes:FindFirstChild("StartBlockEvent")
                    if startBlockEvent then
                        startBlockEvent:FireServer(serverTime)
                    end

                    local blockEvent = remotes:FindFirstChild("BlockEvent")
                    if blockEvent and targetBall then
                        blockEvent:FireServer(targetBall, lookVector)
                        blockEvent:FireServer(targetBall, lookVector, "Block")
                        blockEvent:FireServer(targetBall, lookVector, nil)
                    end
                end
            end)

            if blockRepeat > 1 then
                task.wait(0.01)
            end
        end

        pcall(function()
            if Character then
                Character:SetAttribute("Blocking", true)
                task.wait(0.05)
                Character:SetAttribute("Blocking", false)
            end
        end)
        task.wait(blockDelay)
    end)
end

local function executeDash()
    if not Library.Toggles.NoDashCooldown.Value then
        return
    end

    local currentCharacter = LocalPlayer.Character
    if not currentCharacter then
        return
    end

    local humanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
    local rootPart = currentCharacter:FindFirstChild("HumanoidRootPart")

    if not humanoid or not rootPart then
        return
    end

    humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
    task.spawn(function()
        local endTime = tick() + 0.2
        while endTime > tick() do
            local moveDir = humanoid.MoveDirection
            if moveDir.Magnitude <= 0 then
                moveDir = rootPart.CFrame.LookVector
            end
            rootPart.Velocity = moveDir.Unit * 130
            RunService.RenderStepped:Wait()
        end
        humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, true)
    end)

    ReplicatedStorage.Remotes.ClientVisualEvent:Fire("Dash", currentCharacter)
    ReplicatedStorage.Remotes.AbilityEvent:FireServer("Dash")
end

local function updateBallESP()
    if not targetBall or not targetBall.Parent then
        targetBall = findBall()
    end

    if Library.Toggles.BallESP.Value and targetBall then
        if not ballHighlight or not ballHighlight.Parent then
            ballHighlight = Instance.new("Highlight")
            ballHighlight.Name = "BallHighlight"
            ballHighlight.FillTransparency = 0.5
            ballHighlight.OutlineTransparency = 0
            ballHighlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        end

        if Library.Options.EspFill then
            ballHighlight.FillColor = Library.Options.EspFill.Value
        end

        if Library.Options.EspOutline then
            ballHighlight.OutlineColor = Library.Options.EspOutline.Value
        end

        ballHighlight.Adornee = targetBall
        ballHighlight.Parent = targetBall
        ballHighlight.Enabled = true
        return
    end

    if ballHighlight then
        ballHighlight.Enabled = false
    end
end

local function initializeLoops()
    RunService.Heartbeat:Connect(function()
        pcall(processParry)
    end)
    RunService.RenderStepped:Connect(function()
        pcall(updateBallESP)
    end)
end

